{
	"schemaVersion": 1,
	"id": "challengecraft",
	"version": "${version}",
	"name": "ChallengeCraft",
	"description": "A configurable survival challenge that gives mobs smarter pursuit, pathfinding, building, and breaching behavior.",
	"authors": [
		"Bradderz65"
	],
	"contact": {
		"homepage": "https://github.com/Bradderz65/challengecraft-template-1.21",
		"sources": "https://github.com/Bradderz65/challengecraft-template-1.21"
	},
	"license": "CC0-1.0",
	"icon": "assets/challengecraft/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.example.ChallengeMod"
		],
		"client": [
			"com.example.ChallengeModClient"
		]
	},
	"mixins": [
		"challengecraft.mixins.json",
		{
			"config": "challengecraft.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.18.4",
		"minecraft": "~1.21",
		"java": ">=21",
		"fabric-api": "*"
	}
}